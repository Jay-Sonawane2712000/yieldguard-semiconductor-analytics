Entity Count = DISTINCTCOUNT(mart_dashboard_monitoring_timeline[entity_id])
Failure Count = SUM(mart_dashboard_monitoring_timeline[failure_indicator])
Pass Count = [Entity Count] - [Failure Count]
Failure Rate = DIVIDE([Failure Count], [Entity Count])
Usable Measurements = CALCULATE(COUNTROWS(mart_dashboard_sensor_quality), mart_dashboard_sensor_quality[quality_status] = "eligible")
Excluded Measurements = CALCULATE(COUNTROWS(mart_dashboard_sensor_quality), mart_dashboard_sensor_quality[quality_status] = "excluded")
Monitoring Measurements = CALCULATE(COUNTROWS(mart_dashboard_sensor_quality), mart_dashboard_sensor_quality[monitoring_selection_status] = "selected")
Univariate Alert Entities = CALCULATE([Entity Count], mart_dashboard_monitoring_timeline[any_univariate_signal] = TRUE())
T2 Alert Entities = CALCULATE([Entity Count], mart_dashboard_monitoring_timeline[t2_alert] = TRUE())
Q Alert Entities = CALCULATE([Entity Count], mart_dashboard_monitoring_timeline[q_alert] = TRUE())
Overlap Entities = CALCULATE([Entity Count], mart_dashboard_monitoring_timeline[alert_overlap] = TRUE())
Reviewed Entities = SUM(mart_dashboard_review_budget[entities_reviewed])
Failures Detected = SUM(mart_dashboard_review_budget[failures_detected])
Failures Missed = SUM(mart_dashboard_review_budget[failures_missed])
Review Precision = DIVIDE([Failures Detected], [Reviewed Entities])
Review Recall = DIVIDE([Failures Detected], [Failures Detected] + [Failures Missed])
